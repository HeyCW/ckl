# Copy this file to .env and fill in your Postgres credentials.
# If DB_HOST is left unset (or DB_ENGINE=sqlite), the app uses the
# local SQLite file at data/app.db instead - no other change needed.
#
# DB_HOST should be the server's address on your private network (e.g.
# a WireGuard tunnel IP), never a public one - Postgres should not be
# reachable from the open internet.
#
# Do not use the "postgres" superuser here. Run scripts/postgres_setup.sql
# once on the server to create a dedicated, non-superuser role/database
# (named ckl_app/ckl below), then point DB_USER/DB_NAME at those.

DB_ENGINE=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=ckl
DB_USER=ckl_app
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5

# Connection pool sizing. The app is single-threaded so 1 warm
# connection is normally enough; the max only gives headroom.
DB_POOL_MIN=1
DB_POOL_MAX=4
