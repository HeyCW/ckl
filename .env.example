# Copy this file to .env and fill in your Postgres credentials.
# If DB_HOST is left unset (or DB_ENGINE=sqlite), the app uses the
# local SQLite file at data/app.db instead - no other change needed.

DB_ENGINE=postgres
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=5

# Connection pool sizing. The app is single-threaded so 1 warm
# connection is normally enough; the max only gives headroom.
DB_POOL_MIN=1
DB_POOL_MAX=4
